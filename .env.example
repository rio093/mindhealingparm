# Copy to .env (never commit .env). Used by api/ritual-card.js and packages/ritual-card.
# .env로 복사해서 사용하세요 (.env는 커밋하지 않습니다).

# Optional. Without it the ritual card falls back to rule-based copy.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-5-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1/responses

# AI path abuse controls (api/ritual-card.js)
# RITUAL_AI_LIMIT=5
# RITUAL_AI_WINDOW_MS=60000
# RITUAL_ALLOWED_ORIGINS=https://mindhealingparm.vercel.app
